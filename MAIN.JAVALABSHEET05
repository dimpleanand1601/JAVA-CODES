Q20. University Employee System
This final program combines encapsulation, getters and setters, hierarchical and multilevel inheritance, interfaces, method overriding, @Override, super and multiple objects.
Inheritance diagram
Employee
Teacher
implements Researcher
VisitingTeacher

Admin


Researcher is an interface implemented by Teacher and inherited by VisitingTeacher.

Complete Java program
Save as UniversitySystem.java.

interface Researcher {
    void conductResearch();
}

class Employee {
    private int employeeId;
    private String employeeName;
    private double salary;

    public void setEmployeeId(int employeeId) {
        this.employeeId = employeeId;
    }

    public int getEmployeeId() {
        return employeeId;
    }

    public void setEmployeeName(String employeeName) {
        this.employeeName = employeeName;
    }

    public String getEmployeeName() {
        return employeeName;
    }

    public void setSalary(double salary) {
        if (salary >= 0) {
            this.salary = salary;
        } else {
            System.out.println("Invalid salary.");
        }
    }

    public double getSalary() {
        return salary;
    }

    void displayDetails() {
        System.out.println("Employee ID: " + getEmployeeId());
        System.out.println("Name: " + getEmployeeName());
        System.out.println("Salary: " + getSalary());
    }

    double calculateSalary() {
        return getSalary();
    }
}

class Teacher extends Employee implements Researcher {
    String subject;

    void teach() {
        System.out.println("Teaching subject: " + subject);
    }

    @Override
    void displayDetails() {
        super.displayDetails();
        System.out.println("Subject: " + subject);
    }

    @Override
    double calculateSalary() {
        return super.calculateSalary();
    }

    @Override
    public void conductResearch() {
        System.out.println("Teacher is conducting research.");
    }
}

class VisitingTeacher extends Teacher {
    int hoursWorked;

    @Override
    double calculateSalary() {
        double hourlyRate = 500;
        return hoursWorked * hourlyRate;
    }
}

class Admin extends Employee {
    String department;

    void manageDepartment() {
        System.out.println("Managing department: " + department);
    }

    @Override
    void displayDetails() {
        super.displayDetails();
        System.out.println("Department: " + department);
    }
}

public class UniversitySystem {
    public static void main(String[] args) {
        Teacher t = new Teacher();
        t.setEmployeeId(101);
        t.setEmployeeName("Meena");
        t.setSalary(50000);
        t.subject = "Java";

        System.out.println("--- Teacher Details ---");
        t.displayDetails();
        t.teach();
        t.conductResearch();
        System.out.println("Salary: " + t.calculateSalary());

        VisitingTeacher vt = new VisitingTeacher();
        vt.setEmployeeId(102);
        vt.setEmployeeName("Rahul");
        vt.setSalary(0);
        vt.subject = "Programming";
        vt.hoursWorked = 40;

        System.out.println("\n--- Visiting Teacher ---");
        vt.displayDetails();
        vt.teach();
        vt.conductResearch();
        System.out.println("Salary: " + vt.calculateSalary());

        Admin a = new Admin();
        a.setEmployeeId(103);
        a.setEmployeeName("Priya");
        a.setSalary(40000);
        a.department = "Administration";

        System.out.println("\n--- Admin Details ---");
        a.displayDetails();
        a.manageDepartment();
        System.out.println("Salary: " + a.calculateSalary());
    }
}